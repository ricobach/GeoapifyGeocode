{
  "title": "GeoapifyGeocode",
  "config": {
    "step": {
      "user": {
        "title": "GeoapifyGeocode",
        "description": "Enter your Geoapify API key and choose one or more person or device tracker entities.",
        "data": {
          "api_key": "API key",
          "targets": "Tracked entities"
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate GeoapifyGeocode",
        "description": "The configured Geoapify API key is no longer accepted. Enter a valid API key.",
        "data": {
          "api_key": "API key"
        }
      },
      "reconfigure": {
        "title": "Update Geoapify API key",
        "description": "Enter the Geoapify API key to use for this integration.",
        "data": {
          "api_key": "API key"
        }
      }
    },
    "error": {
      "cannot_connect": "Unable to connect to Geoapify.",
      "invalid_auth": "The Geoapify API key is invalid.",
      "rate_limited": "Geoapify is rate limiting requests. Try again later.",
      "unknown": "Unexpected response from Geoapify."
    },
    "abort": {
      "reauth_successful": "Reauthentication was successful.",
      "reconfigure_successful": "Configuration was updated successfully."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "GeoapifyGeocode options",
        "data": {
          "scan_interval": "Geocode update interval (seconds)",
          "min_distance_m": "Minimum movement before calling Geoapify (metres)",
          "max_age": "Maximum geocode result age before refreshing (seconds)",
          "movement_history_window": "Movement history window (seconds)",
          "movement_comparison_age": "Movement comparison target age (seconds)",
          "movement_min_reference_age": "Minimum movement reference age (seconds)",
          "movement_min_distance_m": "Minimum GPS movement distance (metres)",
          "movement_default_accuracy": "Fallback GPS accuracy when missing (metres)",
          "movement_stationary_timeout": "Moving-to-stationary hold time (seconds)",
          "targets": "Tracked entities"
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "geocode": {
        "name": "{source} Geocode"
      }
    },
    "binary_sensor": {
      "moving": {
        "name": "{source} Moving"
      }
    }
  }
}
